<script>
  function togglePasswordVisibility(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    if (!input || !icon) return;
    if (input.type === 'password') {
      input.type = 'text';
      icon.textContent = 'visibility_off';
    } else {
      input.type = 'password';
      icon.textContent = 'visibility';
    }
  }

  const pwdInput = document.getElementById('mgr-pwd');
  const confirmPwdInput = document.getElementById('mgr-confirm-pwd');
  const chkLen = document.getElementById('chk-len');
  const chkAlpha = document.getElementById('chk-alpha');
  const chkMatch = document.getElementById('chk-match');

  function validateLivePassword() {
    const val = pwdInput.value || '';
    const confirmVal = confirmPwdInput.value || '';

    // Length check
    if (val.length >= 8) {
      chkLen.textContent = 'check_circle';
      chkLen.className = 'material-symbols-outlined text-[16px] text-secondary';
    } else {
      chkLen.textContent = 'radio_button_unchecked';
      chkLen.className = 'material-symbols-outlined text-[16px] text-outline';
    }

    // Letters and numbers mixed
    const hasLetters = /[a-zA-Z]/.test(val);
    const hasNumbers = /[0-9]/.test(val);
    if (hasLetters && hasNumbers) {
      chkAlpha.textContent = 'check_circle';
      chkAlpha.className = 'material-symbols-outlined text-[16px] text-secondary';
    } else {
      chkAlpha.textContent = 'radio_button_unchecked';
      chkAlpha.className = 'material-symbols-outlined text-[16px] text-outline';
    }

    // Match check
    if (val.length > 0 && confirmVal.length > 0 && val === confirmVal) {
      chkMatch.textContent = 'check_circle';
      chkMatch.className = 'material-symbols-outlined text-[16px] text-secondary';
    } else {
      chkMatch.textContent = 'radio_button_unchecked';
      chkMatch.className = 'material-symbols-outlined text-[16px] text-outline';
    }
  }

  if (pwdInput && confirmPwdInput) {
    pwdInput.addEventListener('input', validateLivePassword);
    confirmPwdInput.addEventListener('input', validateLivePassword);
  }

  // UI State Preview Helpers
  const normalBtn = document.getElementById('state-normal-btn');
  const errorBtn = document.getElementById('state-error-btn');
  const loadingBtn = document.getElementById('state-loading-btn');
  const alertContainer = document.getElementById('form-alert-container');
  const successContainer = document.getElementById('form-success-container');
  const submitBtnText = document.getElementById('submit-btn-text');
  const submitBtnIcon = document.getElementById('submit-btn-icon');
  const submitSpinner = document.getElementById('submit-spinner');

  const errorIds = ['err-name', 'err-email', 'err-phone', 'err-pwd-match', 'err-factory', 'err-loc', 'err-size', 'err-type'];

  function resetState() {
    alertContainer.classList.add('hidden');
    successContainer.classList.add('hidden');
    errorIds.forEach(id => {
      const el = document.getElementById(id);
      if (el) el.classList.add('hidden');
    });
    submitBtnText.textContent = 'Create Factory Account';
    submitBtnIcon.classList.remove('hidden');
    submitSpinner.classList.add('hidden');

    normalBtn.className = 'px-space-sm py-space-2xs bg-surface-container-lowest text-on-surface rounded-DEFAULT shadow-xs font-medium transition-colors';
    errorBtn.className = 'px-space-sm py-space-2xs hover:bg-surface-container-lowest text-on-surface-variant rounded-DEFAULT transition-colors';
    loadingBtn.className = 'px-space-sm py-space-2xs hover:bg-surface-container-lowest text-on-surface-variant rounded-DEFAULT transition-colors';
  }

  normalBtn.addEventListener('click', resetState);

  errorBtn.addEventListener('click', () => {
    resetState();
    errorBtn.className = 'px-space-sm py-space-2xs bg-error text-on-error rounded-DEFAULT shadow-xs font-medium transition-colors';
    normalBtn.className = 'px-space-sm py-space-2xs hover:bg-surface-container-lowest text-on-surface-variant rounded-DEFAULT transition-colors';
    alertContainer.classList.remove('hidden');
    
    // Highlight sample validation fields
    document.getElementById('err-name').classList.remove('hidden');
    document.getElementById('err-email').classList.remove('hidden');
    document.getElementById('err-pwd-match').classList.remove('hidden');
    document.getElementById('err-loc').classList.remove('hidden');
    document.getElementById('err-size').classList.remove('hidden');
  });

  loadingBtn.addEventListener('click', () => {
    resetState();
    loadingBtn.className = 'px-space-sm py-space-2xs bg-surface-container-highest text-on-surface rounded-DEFAULT shadow-xs font-medium transition-colors';
    normalBtn.className = 'px-space-sm py-space-2xs hover:bg-surface-container-lowest text-on-surface-variant rounded-DEFAULT transition-colors';
    submitBtnText.textContent = 'Synthesizing Plant Node...';
    submitBtnIcon.classList.add('hidden');
    submitSpinner.classList.remove('hidden');
  });

  function handleFormSubmission() {
    resetState();
    submitBtnText.textContent = 'Verifying CEB Connection...';
    submitBtnIcon.classList.add('hidden');
    submitSpinner.classList.remove('hidden');

    setTimeout(() => {
      submitBtnText.textContent = 'Account Created';
      submitSpinner.classList.add('hidden');
      submitBtnIcon.textContent = 'check';
      submitBtnIcon.classList.remove('hidden');
      successContainer.classList.remove('hidden');
    }, 1200);
  }
