<div class="flex flex-col gap-space-sm">
<label class="font-label-sm text-label-sm uppercase tracking-wider font-semibold text-on-surface">Factory Name &amp; Division</label>
<input class="h-10 px-space-md bg-surface-container-low rounded-lg font-body-md text-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary" placeholder="e.g. Apex Apparel Processing Plant #4" type="text"/>
<label class="font-label-sm text-label-sm uppercase tracking-wider font-semibold text-on-surface">CEB Account / Meter ID</label>
<input class="h-10 px-space-md bg-surface-container-low rounded-lg font-label-md text-label-md text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary" placeholder="e.g. CEB-IND-99482-COL" type="text"/>
<label class="font-label-sm text-label-sm uppercase tracking-wider font-semibold text-on-surface">Official Plant Engineer Email</label>
<input class="h-10 px-space-md bg-surface-container-low rounded-lg font-body-md text-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary" placeholder="plant.lead@factory-name.lk" type="email"/>
</div>
<div class="flex items-center justify-end gap-space-sm mt-space-sm">
<button class="px-space-md h-10 font-body-md text-body-md text-on-surface-variant hover:text-on-surface" onclick="closeRegistrationModal()" type="button">Cancel</button>
<button class="px-space-lg h-10 bg-secondary text-on-secondary rounded-lg font-body-md text-body-md font-semibold hover:bg-secondary/90 transition-all" onclick="confirmRegistrationRequest()" type="button">Submit for Grid Verification</button>
</div>
