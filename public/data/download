<span class="material-symbols-outlined text-[18px] text-secondary">add_business</span>
<span>Create Factory Manager Account</span>
</button>
</div>
<!-- High Security Trust Signifiers -->
<div class="mt-space-lg pt-space-md flex flex-wrap items-center justify-center gap-x-space-md gap-y-space-xs text-on-surface-variant">
<div class="flex items-center gap-space-2xs">
<span class="material-symbols-outlined text-[15px] text-secondary">shield_lock</span>
<span class="font-label-sm text-label-sm">256-bit Encrypted</span>
</div>
<span class="text-outline-variant">•</span>
<div class="flex items-center gap-space-2xs">
<span class="material-symbols-outlined text-[15px] text-secondary">grid_goldenratio</span>
<span class="font-label-sm text-label-sm">CEB / LECO Protocol</span>
</div>
<span class="text-outline-variant">•</span>
<div class="flex items-center gap-space-2xs">
<span class="material-symbols-outlined text-[15px] text-secondary">verified_user</span>
