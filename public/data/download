<button class="w-full h-12 mt-space-xs bg-secondary text-on-secondary hover:bg-secondary/90 active:scale-[0.99] font-headline-sm text-headline-sm rounded-lg shadow-sm flex items-center justify-center gap-space-sm transition-all cursor-pointer group" id="loginSubmitBtn" type="submit">
<span>Authenticate &amp; Access Dashboard</span>
<span class="material-symbols-outlined text-[20px] transition-transform group-hover:translate-x-1">arrow_forward</span>
</button>
</form>
