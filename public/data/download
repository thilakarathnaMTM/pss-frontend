<div>
<h2 class="font-headline-sm text-headline-sm text-on-surface leading-tight">Register Garment Unit</h2>
<p class="font-label-sm text-label-sm text-on-surface-variant">Board of Investment (BOI) &amp; CEB SME Validation</p>
</div>
</div>
<button class="text-outline hover:text-on-surface p-space-xs" onclick="closeRegistrationModal()">
<span class="material-symbols-outlined text-[20px]">close</span>
</button>
