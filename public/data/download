<script>
    function togglePasswordVisibility() {
      const passwordInput = document.getElementById('managerPassword');
      const eyeIcon = document.getElementById('eyeIcon');
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        eyeIcon.textContent = 'visibility_off';
      } else {
        passwordInput.type = 'password';
        eyeIcon.textContent = 'visibility';
      }
    }

    function validateSmeEmail(val) {
      const feedback = document.getElementById('emailValidationFeedback');
      if (val.includes('@') && (val.includes('.lk') || val.includes('.com') || val.includes('apparel') || val.includes('textile'))) {
        feedback.classList.remove('hidden');
        feedback.classList.add('inline-flex');
      } else {
        feedback.classList.add('hidden');
        feedback.classList.remove('inline-flex');
      }
    }

    function handleFactoryLogin() {
      const btn = document.getElementById('loginSubmitBtn');
      const originalText = btn.innerHTML;
      btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[20px]">sync</span><span>Verifying Grid Authentication...</span>';
      btn.classList.add('opacity-80', 'pointer-events-none');
      
      setTimeout(() => {
        btn.innerHTML = '<span class="material-symbols-outlined text-[20px]">check</span><span>Telemetry Link Established</span>';
        btn.classList.remove('bg-secondary');
        btn.classList.add('bg-on-tertiary-container');
        setTimeout(() => {
          btn.innerHTML = originalText;
          btn.classList.remove('opacity-80', 'pointer-events-none', 'bg-on-tertiary-container');
          btn.classList.add('bg-secondary');
          alert('Grid credentials verified. Launching live factory telemetry cockpit.');
        }, 800);
      }, 1000);
    }

    function openRegistrationModal() {
      document.getElementById('registerModal').classList.remove('hidden');
    }

    function closeRegistrationModal() {
      document.getElementById('registerModal').classList.add('hidden');
    }

    function confirmRegistrationRequest() {
      closeRegistrationModal();
      alert('Registration request dispatched to Ceylon Electricity Board SME Energy Coordination Council. Verification link sent to plant email.');
    }

    // Dynamic Time of Use Indicator according to Sri Lanka Standard Time
    (function updateTariffWindow() {
      const indicator = document.getElementById('tariffWindowIndicator');
      if (!indicator) return;
      const now = new Date();
      // Sri Lanka is UTC+5:30
      const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
      const slTime = new Date(utc + (3600000 * 5.5));
      const hours = slTime.getHours();
      const minutes = slTime.getMinutes();
      const timeVal = hours + minutes / 60;

      if (timeVal >= 18.5 && timeVal < 22.5) {
        indicator.textContent = 'Peak Tariff Active (18:30 - 22:30)';
        indicator.className = 'font-label-sm text-label-sm px-space-xs py-space-2xs rounded bg-error-container text-on-error-container font-semibold animate-pulse';
      } else if (timeVal >= 22.5 || timeVal < 5.5) {
        indicator.textContent = 'Off-Peak Tariff (22:30 - 05:30)';
        indicator.className = 'font-label-sm text-label-sm px-space-xs py-space-2xs rounded bg-surface-container-high text-on-surface font-semibold';
      } else {
        indicator.textContent = 'Day Rate Active (05:30 - 18:30)';
        indicator.className = 'font-label-sm text-label-sm px-space-xs py-space-2xs rounded bg-secondary-container text-on-secondary-container font-semibold';
      }
    })();
  </script>
