<label class="inline-flex items-center gap-space-xs cursor-pointer select-none">
<input checked="" class="sr-only peer" id="rememberPlantUnit" type="checkbox"/>
<div class="w-4 h-4 rounded bg-surface-container-low peer-checked:bg-secondary flex items-center justify-center text-on-secondary shadow-sm transition-colors">
<span class="material-symbols-outlined text-[14px] leading-none opacity-0 peer-checked:opacity-100 font-bold">check</span>
</div>
<span class="font-body-sm text-body-sm text-on-surface">Remember unit token</span>
</label>
<a class="font-label-sm text-label-sm font-semibold text-secondary hover:underline transition-all" href="javascript:void(0)" onclick="alert('Password reset instructions dispatched to registered textile unit supervisor.')">
